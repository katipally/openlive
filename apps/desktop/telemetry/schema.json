        "lang": { "k": "enum", "values": ["en", "es", "fr", "de", "it", "pt", "hi", "zh", "ja", "ko"], "opt": true },
        "camera_used": { "k": "bool", "opt": true },
        "screen_used": { "k": "bool", "opt": true },
        "ptt_used": { "k": "bool", "opt": true },
        "has_folder": { "k": "bool", "opt": true },
        "mic_lost": { "k": "int", "max": 999, "opt": true },
        "camera_failed": { "k": "int", "max": 999, "opt": true },
        "screen_failed": { "k": "int", "max": 999, "opt": true },
        "t_look": { "k": "int", "max": 999, "opt": true },
        "t_clipboard": { "k": "int", "max": 999, "opt": true },
        "t_open_url": { "k": "int", "max": 999, "opt": true },
        "t_files": { "k": "int", "max": 999, "opt": true },
        "t_web": { "k": "int", "max": 999, "opt": true },
        "t_plan": { "k": "int", "max": 999, "opt": true },
        "t_memory": { "k": "int", "max": 999, "opt": true },
        "perm_asks": { "k": "int", "max": 999, "opt": true },
        "perm_allowed": { "k": "int", "max": 999, "opt": true },
        "perm_denied": { "k": "int", "max": 999, "opt": true },
        "perm_timeout": { "k": "int", "max": 999, "opt": true },
        "perm_by_voice": { "k": "int", "max": 999, "opt": true },
        "elicitations": { "k": "int", "max": 999, "opt": true },
        "resumed": { "k": "enum", "values": ["none", "resumed", "loaded", "fell_back"], "opt": true },
        "link_drops": { "k": "int", "max": 999, "opt": true },
        "agent_tools": { "k": "int", "max": 999, "opt": true },
        "agent_tools_failed": { "k": "int", "max": 999, "opt": true },
        "errors": { "k": "int", "max": 999, "opt": true },
        "ttft_ms_p50": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "ttft_ms_p95": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "turn_ms_p50": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "agent_start_ms": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "agent_restarts": { "k": "int", "max": 999, "opt": true },
        "stt_ms_p50": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "tts_ms_p50": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "v2v_ms_p50": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "v2v_turns": { "k": "int", "max": 999, "opt": true },
        "stt_family": { "k": "enum", "values": ["whisper", "nemotron", "nemotron-3.5", "parakeet", "moonshine", "canary"], "opt": true },
        "tts_family": { "k": "enum", "values": ["kokoro", "supertonic", "clone", "pocket", "kitten", "piper", "kokoro-native", "matcha"], "opt": true },
        "webgpu": { "k": "bool", "opt": true }
      }
    },
    "brain_error": {
      "props": {
        "surface": { "k": "enum", "values": ["flow", "call"] },
        "brain_kind": { "k": "enum", "values": ["api", "acp"], "opt": true },
        "brain_id": { "k": "enum", "values": ["anthropic", "openai", "minimax", "ollama", "ollama-cloud", "groq", "openrouter", "deepseek", "mistral", "xai", "google", "together", "fireworks", "cerebras", "perplexity", "claude-code", "codex", "cursor", "opencode", "hermes", "gemini", "copilot", "kiro", "pi"], "opt": true },
        "class": { "k": "enum", "values": ["no_key", "no_model", "auth", "model_not_found", "quota", "rate_limited", "unreachable", "server_error", "bad_request", "stream_error", "other", "agent_no_folder", "agent_start_failed", "agent_start_timeout", "agent_no_output", "agent_stalled", "agent_crashed", "agent_rejected", "agent_refused"] },
        "recovered": { "k": "bool", "opt": true },
        "http_class": { "k": "enum", "values": ["4xx", "5xx", "none"], "opt": true }
      },
      "limit": { "dedupeMs": 300000, "dedupeKey": ["class", "brain_id"] }
    },
    "flow_failure_card": {
      "props": {
        "code": { "k": "enum", "values": ["no_provider", "no_accessibility", "secure_input", "offline", "models_missing", "hook_failed", "addon_missing", "mic_failed", "answer_lost", "brain_setup", "turn_failed"] },
        "origin": { "k": "enum", "values": ["health", "turn", "mic", "lost_answer", "link"], "opt": true },
        "brain_kind": { "k": "enum", "values": ["api", "acp"], "opt": true },
        "brain_id": { "k": "enum", "values": ["anthropic", "openai", "minimax", "ollama", "ollama-cloud", "groq", "openrouter", "deepseek", "mistral", "xai", "google", "together", "fireworks", "cerebras", "perplexity", "claude-code", "codex", "cursor", "opencode", "hermes", "gemini", "copilot", "kiro", "pi"], "opt": true }
      },
      "limit": { "dedupeMs": 600000, "dedupeKey": ["code"] }
    },
    "crash_detected": {
      "props": {
        "source": { "k": "enum", "values": ["renderer", "gpu", "utility", "main_previous_run"] },
        "reason": { "k": "enum", "values": ["crashed", "oom", "killed", "abnormal-exit", "launch-failed", "integrity-failure", "memory-eviction", "unclean_exit"] },
        "target": { "k": "enum", "values": ["main_window", "flow_owner", "flow_orb", "cursor_overlay", "splash", "other", "none"], "opt": true },
        "exit_code": { "k": "int", "max": 999, "min": -1, "opt": true }
      },
      "limit": { "perLaunch": 3 }
    },
    "service_crashed": {
      "props": {
        "service": { "k": "enum", "values": ["agent", "web"] },
        "exit_code": { "k": "int", "max": 999, "min": -1, "opt": true },
        "respawn_n": { "k": "int", "max": 99, "opt": true },
