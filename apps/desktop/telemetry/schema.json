{
  "version": 1,
  "common": {
    "app_version": { "k": "str", "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.]+)?$", "max": 20 },
    "platform": { "k": "enum", "values": ["darwin", "win32", "linux"] },
    "arch": { "k": "enum", "values": ["arm64", "x64"] },
    "arch_translated": { "k": "bool" },
    "os_major": { "k": "str", "pattern": "^([0-9]{1,2}|linux)$", "max": 8 },
    "username": { "k": "str", "pattern": "^[a-z]{3,12}-[a-z]{3,12}-[0-9a-f]{8}$", "max": 40 }
  },
  "events": {
    "app_first_open": {
      "props": {
        "origin": { "k": "enum", "values": ["fresh", "existing_install"] },
        "launch_kind": { "k": "enum", "values": ["manual", "login"] }
      },
      "limit": { "oncePerInstall": true }
    },
    "app_launch": {
      "props": {
        "launch_kind": { "k": "enum", "values": ["manual", "login"] },
        "boot_result": { "k": "enum", "values": ["ok", "ports_blocked", "servers_timeout"] },
        "boot_ms": { "k": "int", "max": 600000, "step": 100, "opt": true },
        "agent_port_moved": { "k": "bool", "opt": true },
        "prev_exit_clean": { "k": "bool", "opt": true },
        "login_item": { "k": "bool", "opt": true },
        "linux_session": { "k": "enum", "values": ["x11", "wayland", "n/a"], "opt": true },
        "look": { "k": "enum", "values": ["glass", "flat"], "opt": true },
        "glass_blocked_by": { "k": "enum", "values": ["none", "unsupported-os", "no-gpu", "reduce-transparency", "slow"], "opt": true },
        "theme": { "k": "enum", "values": ["system", "light", "dark"], "opt": true }
      },
      "limit": { "perLaunch": 1 }
    },
    "app_active_day": {
      "props": {
        "first_surface": { "k": "enum", "values": ["main_window", "flow", "call", "tray"] }
      },
      "limit": { "perDay": 1 }
    },
    "app_updated": {
      "props": {
        "from_version": { "k": "str", "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.]+)?$", "max": 20 },
        "to_version": { "k": "str", "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.]+)?$", "max": 20 }
      },
      "limit": { "perLaunch": 1 }
    },
    "update_result": {
      "props": {
        "stage": { "k": "enum", "values": ["available", "downloaded", "restart_now", "restart_later", "up_to_date", "failed"] },
        "to_version": { "k": "str", "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.]+)?$", "max": 20, "opt": true },
        "manual": { "k": "bool", "opt": true },
        "error_kind": { "k": "enum", "values": ["feed_missing", "asset_missing", "signature_invalid", "network", "other"], "opt": true }
      },
      "limit": { "perDayPerKey": 1, "dayKey": ["stage", "error_kind", "manual"] }
    },
    "app_quit": {
      "props": {
        "via": { "k": "enum", "values": ["tray_menu", "app_menu", "update_restart", "no_tray", "os_shutdown", "boot_failed", "other"] },
        "uptime_h": { "k": "dec", "max": 999, "places": 1, "opt": true }
      },
      "limit": { "perLaunch": 1 }
    },
    "flow_session": {
      "props": {
        "brain_kind": { "k": "enum", "values": ["api", "acp"], "opt": true },
        "brain_id": { "k": "enum", "values": ["anthropic", "openai", "minimax", "ollama", "ollama-cloud", "groq", "openrouter", "deepseek", "mistral", "xai", "google", "together", "fireworks", "cerebras", "perplexity", "claude-code", "codex", "cursor", "opencode", "hermes", "gemini", "copilot", "kiro", "pi"], "opt": true },
        "duration_s": { "k": "int", "max": 86400 },
        "ended_by": { "k": "enum", "values": ["gesture", "orb_button", "idle", "disarmed", "sleep_or_lock", "quit", "other"] },
        "opened_by": { "k": "enum", "values": ["gesture", "carry_on", "tray_new", "late_speech"], "opt": true },
        "ready": { "k": "enum", "values": ["ok", "no_brain", "mic_failed"], "opt": true },
        "ready_ms": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "turns": { "k": "int", "max": 999 },
        "acted": { "k": "bool" },
        "consent": { "k": "bool", "opt": true },
        "lang": { "k": "enum", "values": ["en", "es", "fr", "de", "it", "pt", "hi", "zh", "ja", "ko"], "opt": true },
        "steered": { "k": "int", "max": 999, "opt": true },
        "quiet_turns": { "k": "int", "max": 999, "opt": true },
        "stops": { "k": "int", "max": 999, "opt": true },
        "barge_ins": { "k": "int", "max": 999, "opt": true },
        "top_quiet_reason": { "k": "enum", "values": ["none", "meeting", "mic_busy", "dnd", "output_muted", "off"], "opt": true },
        "tool_calls": { "k": "int", "max": 999, "opt": true },
        "tool_errors": { "k": "int", "max": 999, "opt": true },
        "t_insert": { "k": "int", "max": 999, "opt": true },
        "t_words": { "k": "int", "max": 999, "opt": true },
        "t_see": { "k": "int", "max": 999, "opt": true },
        "t_point": { "k": "int", "max": 999, "opt": true },
        "t_keys": { "k": "int", "max": 999, "opt": true },
        "t_window": { "k": "int", "max": 999, "opt": true },
        "t_open": { "k": "int", "max": 999, "opt": true },
        "t_shell": { "k": "int", "max": 999, "opt": true },
        "t_memory": { "k": "int", "max": 999, "opt": true },
        "perm_asks": { "k": "int", "max": 999, "opt": true },
        "perm_allowed": { "k": "int", "max": 999, "opt": true },
        "perm_denied": { "k": "int", "max": 999, "opt": true },
        "perm_timeout": { "k": "int", "max": 999, "opt": true },
        "perm_auto": { "k": "int", "max": 999, "opt": true },
        "perm_by_voice": { "k": "int", "max": 999, "opt": true },
        "failure_cards": { "k": "int", "max": 999, "opt": true },
        "fixes_clicked": { "k": "int", "max": 999, "opt": true },
        "last_failure": { "k": "enum", "values": ["none", "no_provider", "no_accessibility", "secure_input", "offline", "models_missing", "hook_failed", "addon_missing", "mic_failed", "answer_lost", "brain_setup", "turn_failed"], "opt": true },
        "lost_silence": { "k": "int", "max": 999, "opt": true },
        "lost_link": { "k": "int", "max": 999, "opt": true },
        "link_drops": { "k": "int", "max": 999, "opt": true },
        "mic_lost": { "k": "int", "max": 999, "opt": true },
        "agent_tools": { "k": "int", "max": 999, "opt": true },
        "agent_tools_failed": { "k": "int", "max": 999, "opt": true },
        "errors": { "k": "int", "max": 999, "opt": true },
        "ttft_ms_p50": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "ttft_ms_p95": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "turn_ms_p50": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "agent_start_ms": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "agent_restarts": { "k": "int", "max": 999, "opt": true },
        "stt_ms_p50": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "tts_ms_p50": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "v2v_ms_p50": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "v2v_turns": { "k": "int", "max": 999, "opt": true },
        "stt_family": { "k": "enum", "values": ["whisper", "nemotron", "nemotron-3.5", "parakeet", "moonshine", "canary"], "opt": true },
        "tts_family": { "k": "enum", "values": ["kokoro", "supertonic", "clone", "pocket", "kitten", "piper", "kokoro-native", "matcha"], "opt": true },
        "webgpu": { "k": "bool", "opt": true }
      },
      "derive": { "acted": ["t_insert", "t_keys", "t_point", "t_window", "t_open", "t_shell"] }
    },
    "call_session": {
      "props": {
        "brain_kind": { "k": "enum", "values": ["api", "acp"], "opt": true },
        "brain_id": { "k": "enum", "values": ["anthropic", "openai", "minimax", "ollama", "ollama-cloud", "groq", "openrouter", "deepseek", "mistral", "xai", "google", "together", "fireworks", "cerebras", "perplexity", "claude-code", "codex", "cursor", "opencode", "hermes", "gemini", "copilot", "kiro", "pi"], "opt": true },
        "duration_s": { "k": "int", "max": 86400 },
        "ended_by": { "k": "enum", "values": ["end_button", "orb_end", "window_closed", "sleep_or_lock", "start_failed", "switched_chat", "app_quit", "other"] },
        "start_result": { "k": "enum", "values": ["ok", "mic_denied", "start_failed"], "opt": true },
        "start_ms": { "k": "int", "max": 600000, "step": 10, "opt": true },
        "turns": { "k": "int", "max": 999 },
