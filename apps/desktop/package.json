{
  "name": "@openlive/desktop",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "OpenLive: live voice + vision AI assistant (desktop)",
  "author": "OpenLive",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "start:dev": "cross-env ELECTRON_DEV=1 electron . --remote-debugging-port=9333",
    "pack:web": "node scripts/pack-web.cjs",
    "pack:agent": "node scripts/pack-agent.cjs",
    "pack:native": "node scripts/pack-native.cjs",
    "pack:telemetry": "node scripts/pack-telemetry.cjs",
    "pack:licenses": "node scripts/pack-licenses.cjs",
    "pack": "node scripts/pack-web.cjs && node scripts/pack-agent.cjs && node scripts/pack-native.cjs && node scripts/pack-licenses.cjs && node scripts/pack-telemetry.cjs",
    "build": "pnpm run pack && electron-builder",
    "build:mac": "pnpm run pack && electron-builder --mac",
    "build:win": "pnpm run pack && electron-builder --win",
    "build:linux": "pnpm run pack && electron-builder --linux"
  },
  "dependencies": {
    "@openlive/flow-store": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2"
  }
}
